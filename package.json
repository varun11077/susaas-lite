{
  "name": "susaas-lite",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@sap/cds": "^10",
    "@sap/cds-mtxs": "^4"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1.0.2",
    "@cap-js/sqlite": "^3",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "start": "cds-serve",
    "test": "vitest run"
  },
  "cds": {
    "requires": {
      "auth": {
        "[development]": {
          "kind": "basic",
          "users": {
            "alice": {
              "roles": [
                "Admin",
                "Member"
              ]
            },
            "carol": {
              "roles": [
                "Member"
              ]
            },
            "dave": {
              "roles": [
                "Member"
              ]
            }
          }
        }
      },
      "[production]": {
        "multitenancy": true
      },
      "[with-mtx]": {
        "multitenancy": true
      }
    },
    "profile": "with-mtx-sidecar"
  },
  "private": true
}
